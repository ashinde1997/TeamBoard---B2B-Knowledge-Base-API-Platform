                {
                    "name": "6. Query KB - valid token, keyword with results",
                    "id": "95f05dba-526c-4a7d-94b8-145acc325957",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{client_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"search\": \"select_related\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://127.0.0.1:8000/api/kb/query/",
                            "protocol": "http",
                            "host": [
                                "127",
                                "0",
                                "0",
                                "1"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "kb",
                                "query",
                                ""
                            ]
                        },
                        "description": "Scenario 6: Querying KB with keyword that matches entries. Atomically logs the query and returns 200 with result count and entries."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "id": "b8da5e8e-b9e8-4511-ac65-35628a94b156",
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response contains search, count, and results array\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('search', 'select_related');",
                                    "    pm.expect(jsonData).to.have.property('count');",
                                    "    pm.expect(jsonData.count).to.be.at.least(1);",
                                    "    pm.expect(jsonData).to.have.property('results');",
                                    "    pm.expect(jsonData.results).to.be.an('array').that.is.not.empty;",
                                    "    pm.expect(jsonData.results[0]).to.have.property('id');",
                                    "    pm.expect(jsonData.results[0]).to.have.property('question');",
                                    "    pm.expect(jsonData.results[0]).to.have.property('answer');",
                                    "    pm.expect(jsonData.results[0]).to.have.property('category');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "7. Query KB - valid token, no matching results",
                    "id": "c82c4431-4ff4-4ba2-bb77-5f7d0f72bd81",
                    "request": {
                        "auth": {
                            "type": "bearer",

                            "path": [
                                "api",
                                "kb",
                                "query",
                                ""
                            ]
                        },
                        "description": "Scenario 7: When nothing matches, returns 200 with count 0 and empty list, and still records the QueryLog entry."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "id": "0d522fea-f34b-4653-803a-d862c927a655",
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Returns empty results list with count 0\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('search', 'nonexistent_query_term_12345');",
                                    "    pm.expect(jsonData).to.have.property('count', 0);",
                                    "    pm.expect(jsonData).to.have.property('results');",
                                    "    pm.expect(jsonData.results).to.be.an('array').that.is.empty;",
                                    "});"
                                ]
                            }
                        }

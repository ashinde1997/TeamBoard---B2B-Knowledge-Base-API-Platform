                        "description": "Scenario 3: Logs in the company using authenticate() and returns fresh JWT access token alongside company_name and api_key."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "id": "463fb484-2e1d-43ff-9fe0-dd8f3a2c2dfc",
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response contains fresh JWT access token, company_name, and api_key\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('access');",
                                    "    pm.expect(jsonData).to.have.property('company_name', 'Acme Corp');",
                                    "    pm.expect(jsonData).to.have.property('api_key');",
                                    "    pm.expect(jsonData.access).to.be.a('string').and.not.empty;",
                                    "    pm.collectionVariables.set('client_token', jsonData.access);",
                                    "});"
                                ]
                            }
                        }

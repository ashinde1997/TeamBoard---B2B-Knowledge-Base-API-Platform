            "item": [
                {
                    "name": "1. Register a new company",
                    "id": "21b6412b-3cf9-4447-8200-ed39212629a1",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"acmecorp\",\n    \"password\": \"securepass123\",\n    \"company_name\": \"Acme Corp\",\n    \"email\": \"dev@acmecorp.com\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://127.0.0.1:8000/api/auth/register/",
                            "protocol": "http",
                            "host": [
                                "127",
                                "0",
                                "0",
                                "1"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "auth",
                                "register",
                                ""
                            ]
                        },
                        "description": "Scenario 1: Registers a new B2B client company. Generates a User and Company profile via signal with api_key, and returns JWT access token."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "id": "ab65cbda-dac9-429e-952c-af7a8f1cdada",
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 201 Created\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Response contains credentials and token\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('username', 'acmecorp');",
                                    "    pm.expect(jsonData).to.have.property('company_name', 'Acme Corp');",
                                    "    pm.expect(jsonData).to.have.property('api_key');",
                                    "    pm.expect(jsonData).to.have.property('access');",
                                    "    pm.expect(jsonData.api_key).to.be.a('string').and.not.empty;",
                                    "    pm.expect(jsonData.access).to.be.a('string').and.not.empty;",
                                    "",
                                    "    pm.collectionVariables.set('client_token', jsonData.access);",
                                    "    pm.collectionVariables.set('client_api_key', jsonData.api_key);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
